    {
      "id": 16,
      "type": "stat",
      "title": "PostgreSQL exporter",
      "description": "Can Prometheus scrape the PostgreSQL exporter? DOWN here with the 'PostgreSQL' panel also empty means the exporter, not the database, is the problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
