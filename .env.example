# DecisionForge AI — environment variable names only. No secrets/values are committed.
# Copy to .env and fill in real values for local development.
# See docs/11-devops-deployment-runbook.md §2 for the authoritative description of each variable.

# ---- Application (FastAPI backend in backend/) ----
# ENVIRONMENT=production turns on startup validation: JWT_SECRET_KEY >= 32 chars, DEBUG off,
# JWT_REFRESH_COOKIE_SECURE on, no wildcard hosts/origins. The app refuses to start otherwise.
ENVIRONMENT=development
DEBUG=1
LOG_LEVEL=INFO
# Comma-separated Host headers the API will answer to (include the Compose service name "web").
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Legacy Django variables (DJANGO_DEBUG, DJANGO_ALLOWED_HOSTS) are still read as fallbacks;
# DJANGO_SECRET_KEY / DJANGO_SETTINGS_MODULE are no longer used by anything.

# ---- PostgreSQL ----
POSTGRES_DB=decisionforge
POSTGRES_USER=decisionforge
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://decisionforge:@db:5432/decisionforge
# FastAPI needs explicit async/sync driver URLs (see docs/adr/ADR-fastapi-database-migration.md)
DATABASE_URL_ASYNC=postgresql+asyncpg://decisionforge:@db:5432/decisionforge
DATABASE_URL_SYNC=postgresql+psycopg://decisionforge:@db:5432/decisionforge

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# See docs/adr/ADR-fastapi-authentication.md.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=df_refresh
JWT_REFRESH_COOKIE_SECURE=0

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- Gemini / AI ----
GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=3
GEMINI_DAILY_USER_QUOTA=20
GEMINI_CACHE_TTL_SECONDS=86400
GEMINI_BREAKER_FAILURE_THRESHOLD=5
GEMINI_BREAKER_WINDOW_SECONDS=120
GEMINI_BREAKER_COOLDOWN_SECONDS=60
AI_CONCURRENCY_LIMIT=5

# ---- Observability ----
ENABLE_METRICS=true
# Celery worker's own metrics endpoint (scraped by Prometheus as worker:9808).
CELERY_METRICS_PORT=9808
# Only if Redis AUTH is enabled; passed to redis-exporter.
REDIS_PASSWORD=
PROMETHEUS_METRICS_ENABLED=1
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Misc ----
DEMO_SEED_ENABLED=1
