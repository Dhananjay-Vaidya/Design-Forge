# DecisionForge AI — environment variable names only. No secrets/values are committed.
# Copy to .env and fill in real values for local development.
# See docs/11-devops-deployment-runbook.md §2 for the authoritative description of each variable.

# ---- Django core ----
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---- PostgreSQL ----
POSTGRES_DB=decisionforge
POSTGRES_USER=decisionforge
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://decisionforge:@db:5432/decisionforge

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Auth / JWT ----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=df_refresh
JWT_REFRESH_COOKIE_SECURE=0

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- Gemini / AI ----
GEMINI_ENABLED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=3
GEMINI_DAILY_USER_QUOTA=20
GEMINI_CACHE_TTL_SECONDS=86400
GEMINI_BREAKER_FAILURE_THRESHOLD=5
GEMINI_BREAKER_WINDOW_SECONDS=120
GEMINI_BREAKER_COOLDOWN_SECONDS=60

# ---- Observability ----
PROMETHEUS_METRICS_ENABLED=1
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# ---- Misc ----
DEMO_SEED_ENABLED=1
