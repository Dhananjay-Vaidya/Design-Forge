    {
      "type": "stat",
      "title": "API requests/s",
      "description": "Total HTTP request rate (5m).",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "decisionforge:api_request_rate5m or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "API 5xx ratio",
      "description": "Share of responses that are 5xx (5m). Alert above 5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "decisionforge:api_5xx_ratio5m or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "API request rate",
      "description": "Requests per second, all routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "decisionforge:api_request_rate5m",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "P95 API latency",
      "description": "95th percentile request duration. Yellow 0.5s, red 1s.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "decisionforge:api_latency_p95",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Decisions created and rankings",
      "description": "Cumulative business activity in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(decisionforge_decisions_created_total[$__interval]))",
          "legendFormat": "decisions created",
          "refId": "A"
        },
        {
          "expr": "sum(increase(decisionforge_ranking_calculations_total[$__interval]))",
          "legendFormat": "rankings calculated",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "id": 9
    },
    {
