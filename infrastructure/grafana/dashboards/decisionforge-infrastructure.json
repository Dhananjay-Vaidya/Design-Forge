{
  "uid": "decisionforge-infrastructure",
  "title": "DecisionForge Infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "tags": ["decisionforge", "infrastructure"],
  "panels": [
    {"type": "stat", "title": "PostgreSQL Availability", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "up{job=\"postgres-exporter\"}", "legendFormat": "postgres"}], "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}},
    {"type": "timeseries", "title": "PostgreSQL Connections", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}"}], "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}},
    {"type": "timeseries", "title": "PostgreSQL Transaction Rate", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]) + rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "{{datname}}"}], "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}},
    {"type": "timeseries", "title": "PostgreSQL Database Size", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "pg_database_size_bytes", "legendFormat": "{{datname}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}}, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}},
    {"type": "stat", "title": "Redis Availability", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "up{job=\"redis-exporter\"}", "legendFormat": "redis"}], "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4}},
    {"type": "timeseries", "title": "Redis Memory", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "used"}], "fieldConfig": {"defaults": {"unit": "bytes"}}, "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4}},
    {"type": "timeseries", "title": "Redis Connected Clients", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "redis_connected_clients", "legendFormat": "clients"}], "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4}},
    {"type": "timeseries", "title": "Redis Commands and Evictions", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "commands/s"}, {"expr": "rate(redis_evicted_keys_total[5m])", "legendFormat": "evictions/s"}], "gridPos": {"x": 18, "y": 4, "w": 6, "h": 4}}
  ]
}
