{
  "uid": "decisionforge-ai",
  "title": "DecisionForge Gemini and AI Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "tags": ["decisionforge", "ai"],
  "panels": [
    {"type": "timeseries", "title": "Requests by Analysis Type", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "sum by (analysis_type) (rate(decisionforge_ai_requests_total[5m]))", "legendFormat": "{{analysis_type}}"}], "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5}},
    {"type": "timeseries", "title": "Requests by Status", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "sum by (status) (rate(decisionforge_ai_requests_total[5m]))", "legendFormat": "{{status}}"}], "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5}},
    {"type": "timeseries", "title": "Provider P95 Latency", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, provider) (rate(decisionforge_ai_request_duration_seconds_bucket[5m])))", "legendFormat": "{{provider}}"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5}},
    {"type": "timeseries", "title": "Rate Limits and Quota Rejections", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "sum(rate(decisionforge_ai_rate_limit_total[5m]))", "legendFormat": "rate limits"}, {"expr": "sum(rate(decisionforge_ai_quota_rejections_total[5m]))", "legendFormat": "quota rejections"}], "gridPos": {"x": 0, "y": 5, "w": 8, "h": 5}},
    {"type": "timeseries", "title": "Circuit Breaker State", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "decisionforge_ai_circuit_breaker_open", "legendFormat": "{{provider}}"}], "gridPos": {"x": 8, "y": 5, "w": 8, "h": 5}},
    {"type": "timeseries", "title": "Fallbacks and Token Usage", "datasource": {"type": "prometheus", "uid": "decisionforge-prometheus"}, "targets": [{"expr": "sum by (reason) (rate(decisionforge_ai_fallback_total[5m]))", "legendFormat": "fallback {{reason}}"}, {"expr": "sum by (token_type) (rate(decisionforge_ai_token_usage_total[5m]))", "legendFormat": "tokens {{token_type}}"}], "gridPos": {"x": 16, "y": 5, "w": 8, "h": 5}}
  ]
}
