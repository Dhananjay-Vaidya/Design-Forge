{
  "uid": "decisionforge-infrastructure",
  "title": "PostgreSQL and Redis Infrastructure",
  "description": "PostgreSQL, Redis and Celery infrastructure health from the exporters.",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "decisionforge",
    "infrastructure"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "PostgreSQL",
      "description": "postgres-exporter reaches the database.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "pg_up",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Redis",
      "description": "redis-exporter reaches Redis.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "redis_up",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Celery worker",
      "description": "Worker metrics endpoint is scraped.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"decisionforge-worker\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "PG cache hit ratio",
      "description": "Buffer cache hit ratio for the app database. Below 95% suggests memory pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_blks_hit{datname=\"decisionforge\"}) / clamp_min(sum(pg_stat_database_blks_hit{datname=\"decisionforge\"}) + sum(pg_stat_database_blks_read{datname=\"decisionforge\"}), 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Redis hit ratio",
      "description": "keyspace hits / (hits + misses), lifetime.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "redis_keyspace_hits_total / clamp_min(redis_keyspace_hits_total + redis_keyspace_misses_total, 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Celery queue",
      "description": "Tasks waiting in the broker queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "decisionforge:celery_queue_length or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "description": "Active backends per database.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"decisionforge\"}",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL transaction rate",
      "description": "Commits + rollbacks per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "decisionforge-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=\"decisionforge\"}[5m]) + rate(pg_stat_database_xact_rollback{datname=\"decisionforge\"}[5m]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "id": 8
    },
